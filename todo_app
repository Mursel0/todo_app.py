tasks = []


while True:
	print("1.Add task")
	print("2.Show tasks")
	print("3.Delete task")
	print("4.Exit")

	choice = input("Choose: ")
	
	if choice == "1" :
		task = input("Enter task: ")
		tasks.append(task)
		print("Task added!")
	elif choice == "2" :
	  if len(tasks) ==0 :
	  	print("No tasks yet!")
	  else:
		  print("You have",  len(tasks), "tasks:")
		   for task in tasks :
			 print(task)
	elif choice == "3" :
		task = input("Which task to delete? ")
		if task in tasks:
		tasks.remove(task)
		print("Task deleted!")
		else:
			print("Task not found!")
	elif choice == "4" :
		break
	else:
		print("Invalid choice! Please choose 1-4")
